# Plantilla de variables de entorno. Copiar como .env y completar con datos reales.
# El archivo .env real NO se sube a Git.

# Cisco Catalyst Center (DNA Center)
DNAC_URL=https://sandboxdnac.cisco.com
DNAC_USERNAME=cambiar_usuario
DNAC_PASSWORD=cambiar_contrasena
# Dejar en true. Poner false solo en laboratorio con certificado autofirmado.
DNAC_VERIFY_SSL=true

# Router IOS-XE (RESTCONF / NETCONF)
IOSXE_HOST=cambiar_host
IOSXE_PORT=443
IOSXE_USERNAME=cambiar_usuario
IOSXE_PASSWORD=cambiar_contrasena
IOSXE_VERIFY_SSL=true

# Webex (token del bot)
WEBEX_TOKEN=cambiar_token
WEBEX_ROOM_ID=cambiar_id_de_sala
